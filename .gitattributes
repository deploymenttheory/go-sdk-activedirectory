# .gitattributes snippet to force users to use same line endings for project.
# 
# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

*.json text eol=lf
# Third-party license bytes retain the original upstream Git blob.
3rd_party/ldap/LICENSE -text
3rd_party/gokrb5/LICENSE -text
3rd_party/gokrb5/NOTICE -text
3rd_party/*/upstream-go.mod.txt -text
3rd_party/*/upstream-go.sum.txt -text
# Retain upstream documentation whitespace and literal config-fixture inputs.
3rd_party/**/*.md whitespace=-blank-at-eol,-blank-at-eof
3rd_party/gokrb5/v8/config/krb5conf_test.go whitespace=-blank-at-eol
# Captured reference scripts are evidence bytes; preserve recorded SHA-256.
docs/research/dc-cloning-evidence/*.ps1 -text
# Captured native qualification reports retain their original byte digests.
coverage/lab/server2025/cloning/baseline/*.json -text whitespace=cr-at-eol
coverage/lab/server*/cloning/native-cases/*.json -text whitespace=cr-at-eol
coverage/lab/server*/cloning/native-cases/*.ps1 -text whitespace=cr-at-eol
coverage/lab/server2025/cloning/native-resources/*.json -text whitespace=cr-at-eol
coverage/lab/server2025/cloning/native-resources/*.ps1 -text whitespace=cr-at-eol
coverage/lab/server2025/cloning/native-access*/*.json -text whitespace=cr-at-eol
coverage/lab/server2025/cloning/native-access*/*.ps1 -text whitespace=cr-at-eol
coverage/lab/server2025/cloning/native-access*/*.go.txt -text whitespace=cr-at-eol
# Captured capability-contract evidence retains its original byte digests.
coverage/lab/server*/capability-contract-*/*.json -text whitespace=cr-at-eol
coverage/lab/server*/capability-contract-*/*.ps1 -text whitespace=cr-at-eol
coverage/lab/server*/capability-contract-*/*.txt -text whitespace=cr-at-eol
# Portable protocol qualification captures preserve their recorded SHA-256 bytes.
docs/research/portable-ldap-evidence/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
# Portable Kerberos qualification retains exact public capture and manifest bytes.
docs/research/portable-kerberos-evidence/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
# Portable DRS/RPC candidate and live captures preserve their exact recorded bytes.
docs/research/portable-replication-evidence/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol

# Independent native descriptor vectors retain the executed source/result bytes.
conditions/testdata/sdk06-native-* -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
# Descriptor protocol probes retain exact reference source and result bytes.
docs/research/portable-security-descriptor-evidence/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
# SASL stream, relay and independent cleanup captures retain their original bytes.
docs/research/portable-sasl-evidence/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
docs/research/portable-conditional-expression-evidence/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol

# Portable discovery offline build and verification records retain exact bytes.
docs/research/portable-discovery-evidence/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
