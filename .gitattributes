# .gitattributes snippet to force users to use same line endings for project.
# 
# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

*.json text eol=lf
# Captured reference scripts are evidence bytes; preserve recorded SHA-256.
docs/research/dc-cloning-evidence/*.ps1 -text
# Captured native qualification reports retain their original byte digests.
coverage/lab/server2025/cloning/baseline/*.json -text whitespace=cr-at-eol
coverage/lab/server*/cloning/native-cases/*.json -text whitespace=cr-at-eol
coverage/lab/server*/cloning/native-cases/*.ps1 -text whitespace=cr-at-eol
coverage/lab/server2025/cloning/native-resources/*.json -text whitespace=cr-at-eol
coverage/lab/server2025/cloning/native-resources/*.ps1 -text whitespace=cr-at-eol
coverage/lab/server2025/cloning/native-access*/*.json -text whitespace=cr-at-eol
coverage/lab/server2025/cloning/native-access*/*.ps1 -text whitespace=cr-at-eol
coverage/lab/server2025/cloning/native-access*/*.go.txt -text whitespace=cr-at-eol
